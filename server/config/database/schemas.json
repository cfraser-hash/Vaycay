[
  {
    "collection": "users",
    "validator": {
      "$jsonSchema": {
        "title": "users",
        "bsonType": "object",
        "required": ["name", "email", "password"],
        "properties": {
          "name": { "bsonType": "string" },
          "email": {
            "bsonType": "string",
            "pattern": "^.+@.+$"
          },
          "password": { "bsonType": "string" },
          "bio": { "bsonType": "string" },
          "profile_picture_url": { "bsonType": "string" }
        }
      }
    }
  },
  {
    "collection": "trips",
    "validator": {
      "$jsonSchema": {
        "title": "trips",
        "bsonType": "object",
        "required": ["user", "destination", "startDate", "endDate"],
        "properties": {
          "user": {
            "bsonType": "objectId",
            "description": "must be an ObjectId referencing the user who created the trip"
          },
          "destination": {
            "bsonType": "string",
            "description": "must be a string and is required"
          },
          "startDate": {
            "bsonType": "date",
            "description": "must be a date and is required"
          },
          "endDate": {
            "bsonType": "date",
            "description": "must be a date and is required"
          },
          "budget": {
            "bsonType": ["number", "double", "int"],
            "description": "must be a number if specified"
          }
        }
      }
    }
  },
  {
    "collection": "posts",
    "validator": {
      "$jsonSchema": {
        "title": "posts",
        "bsonType": "object",
        "required": ["user", "caption"],
        "properties": {
          "user": {
            "bsonType": "objectId",
            "description": "must be an ObjectId referencing the user who created the post"
          },
          "trip": {
            "bsonType": ["objectId", "null"],
            "description": "optional ObjectId referencing the trip associated with this post"
          },
          "caption": {
            "bsonType": "string",
            "description": "must be a string containing post text/description"
          },
          "media_urls": {
            "bsonType": "array",
            "items": { "bsonType": "string" },
            "description": "must be an array of image/video URL strings"
          },
          "likes": {
            "bsonType": "array",
            "items": { "bsonType": "objectId" },
            "description": "must be an array of user ObjectIds who liked this post"
          },
          "created_at": {
            "bsonType": "date",
            "description": "must be a date recording when the post was published"
          }
        }
      }
    }
  },
  {
    "collection": "messages",
    "validator": {
      "$jsonSchema": {
        "title": "messages",
        "bsonType": "object",
        "required": ["sender", "receiver", "text"],
        "properties": {
          "sender": {
            "bsonType": "objectId",
            "description": "must be an ObjectId referencing the message sender"
          },
          "receiver": {
            "bsonType": "objectId",
            "description": "must be an ObjectId referencing the recipient user or trip group"
          },
          "text": {
            "bsonType": "string",
            "description": "must be a string containing the message content"
          },
          "sent_at": {
            "bsonType": "date",
            "description": "must be a date recording when the message was sent"
          },
          "is_read": {
            "bsonType": "bool",
            "description": "must be a boolean indicating if the recipient read the message"
          }
        }
      }
    }
  },
  {
    "collection": "saved_trips",
    "validator": {
      "$jsonSchema": {
        "title": "saved_trips",
        "bsonType": "object",
        "required": ["user", "trip"],
        "properties": {
          "user": {
            "bsonType": "objectId",
            "description": "must be an ObjectId referencing the User who saved the trip"
          },
          "trip": {
            "bsonType": "objectId",
            "description": "must be an ObjectId referencing the saved Trip"
          },
          "savedAt": {
            "bsonType": "date",
            "description": "must be a date recording when it was saved"
          }
        }
      }
    }
  },
  {
    "collection": "questionnaires",
    "validator": {
      "$jsonSchema": {
        "title": "questionnaires",
        "bsonType": "object",
        "required": ["user_id", "answers"],
        "properties": {
          "user_id": { "bsonType": "objectId" },
          "trip_id": { "bsonType": ["objectId", "null"] },
          "answers": { "bsonType": "object" }
        }
      }
    }
  }
]
